# Default: safe local paper mode
BOT_ENV=paper
BLOFIN_INSTRUMENT=BTC-USDT

# Aggressive multi-timeframe defaults
SIGNAL_MODE=Aggressive
RISK_PCT=0.35
LEVERAGE=3
MAX_SOFTWARE_LEVERAGE=8
MAX_MARGIN_USE_PCT=45
MAX_TOTAL_OPEN_RISK_PCT=5
MAX_DAILY_LOSS_PCT=5
MIN_QUALITY=50
MIN_CONFLUENCE=46
TP_R_MULTIPLE=1.8
MAX_SPREAD_BPS=10
MAX_ENTRY_SLIPPAGE_ATR=0.55
BOT_LOOP_SECONDS=1
PAPER_EQUITY=1000
REQUIRE_MULTI_POSITION=true

# Demo/live credentials — keep local, never commit real values
BLOFIN_API_KEY=
BLOFIN_SECRET_KEY=
BLOFIN_PASSPHRASE=

# Required only for live mode
ALLOW_LIVE_TRADING=
