# Default: safe local paper mode
BOT_ENV=paper
BLOFIN_INSTRUMENT=BTC-USDT

# v2.2 uses a fixed built-in aggressive profile:
# - signal mode: Aggressive
# - risk/trade: 1.45%
# - leverage: 7x
# - max margin use: 45%
# - portfolio planned-risk cap: 11.5%
# - minimum quality: 35%
# - minimum confluence: 25%
# - target: 2.0R
# - multi-position: automatic when the bot is armed
# These values are intentionally not environment-variable controls.

# Independent safety / runtime infrastructure
MAX_DAILY_LOSS_PCT=5
MAX_SPREAD_BPS=10
MAX_ENTRY_SLIPPAGE_ATR=0.55
BOT_LOOP_SECONDS=1
PAPER_EQUITY=1000

# Demo/live credentials — keep local, never commit real values
BLOFIN_API_KEY=
BLOFIN_SECRET_KEY=
BLOFIN_PASSPHRASE=

# Required only for live mode
ALLOW_LIVE_TRADING=
